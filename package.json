{
  "name": "binance-futures-ws-client",
  "version": "1.0.0",
  "description": "Binance Futures WebSocket API - canli fiyat (bookTicker) ve 1 dakikalik kline verisi, otomatik yeniden baglanma destekli",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:wave-browser": "node scripts/build-wave-browser.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/**/__tests__/**/*.test.ts",
    "validate:real-market": "tsx scripts/validate-real-market.ts",
    "measure:historical": "tsx scripts/measure-historical.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.19.2",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
